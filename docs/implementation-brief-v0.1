## 7. Domain rules

## 7.1 Event active-on-day rule

```ts
export function isEventActiveOnDay(event: Event, dayIndex: number): boolean {
  if (event.temporalState === "cancelled") return false;
  if (event.startDayIndex > dayIndex) return false;
  if (event.endDayIndex === null) return true;
  return event.endDayIndex >= dayIndex;
}
```

## 7.2 Event starts-on-day rule

```ts
export function doesEventStartOnDay(event: Event, dayIndex: number): boolean {
  return event.startDayIndex === dayIndex;
}
```

## 7.3 Event ends-on-day rule

```ts
export function doesEventEndOnDay(event: Event, dayIndex: number): boolean {
  if (event.temporalState === "cancelled") return false;
  return event.endDayIndex === dayIndex;
}
```

## 7.4 Event validation rule

```ts
export function validateEventTemporalShape(input: {
  startDayIndex: number;
  endDayIndex: number | null;
  temporalState: EventTemporalState;
}): string[] {
  const errors: string[] = [];

  if (!Number.isInteger(input.startDayIndex)) {
    errors.push("startDayIndex must be an integer");
  }

  if (input.endDayIndex !== null && input.endDayIndex < input.startDayIndex) {
    errors.push("endDayIndex cannot be before startDayIndex");
  }

  if (input.temporalState === "ongoing" && input.endDayIndex !== null) {
    errors.push("ongoing events cannot have an endDayIndex");
  }

  return errors;
}
```

