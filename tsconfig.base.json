{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@campaign-platform/domain": ["packages/domain/src/index.ts"],
      "@campaign-platform/application": ["packages/application/src/index.ts"],
      "@campaign-platform/db": ["packages/db/src/index.ts"]
    }
  }
}
